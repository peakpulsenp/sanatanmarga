# SanatanMarga Environment Configuration
# Copy this file to .env.local and fill in your values
# For production deployment, set these as environment variables in your hosting platform

# ============================================================
# API MODE
# ============================================================
# Options: demo | firebase | firebase+r2 | r2-only | custom
# demo: Uses localStorage/demo data (default, no cloud required)
# firebase: Uses Firebase Firestore + Auth + Storage
# firebase+r2: Uses Firebase for DB/Auth, Cloudflare R2 for Storage + Snapshots
# r2-only: Uses Cloudflare R2 for everything (requires Workers for DB)
# custom: Uses custom backend via VITE_API_BASE_URL
VITE_API_MODE=demo

# ============================================================
# FIREBASE CONFIGURATION (Required for firebase and firebase+r2 modes)
# ============================================================
# Get these from Firebase Console > Project Settings > General > Your apps > Web app
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase Emulator (for local development)
VITE_FIREBASE_USE_EMULATOR=false
VITE_FIREBASE_EMULATOR_HOST=localhost
VITE_FIREBASE_EMULATOR_PORT=8080

# ============================================================
# CLOUDFLARE R2 CONFIGURATION (Required for firebase+r2 and r2-only modes)
# ============================================================
# 1. Media Bucket (Marketplace-media) - For images, audio, video, documents, uploads
VITE_R2_MEDIA_BUCKET=Marketplace-media
VITE_R2_MEDIA_PUBLIC_URL=https://pub-xxxxx.r2.dev

# 2. Snapshots Bucket (sanatanmarga-snapshots) - For static JSON snapshots, manifest, offline journal
VITE_R2_SNAPSHOTS_BUCKET=sanatanmarga-snapshots
VITE_R2_SNAPSHOTS_PUBLIC_URL=https://pub-yyyyy.r2.dev

# Fallback unified public URL / custom domain (if using a single custom domain or proxy)
VITE_R2_PUBLIC_URL=https://assets.sanatanmarga.com

# ============================================================
# AI SERVICES CONFIGURATION
# ============================================================
# Provider: gemini | vertex | openai | custom
VITE_AI_PROVIDER=gemini

# Google Gemini (Google AI Studio)
VITE_GEMINI_API_KEY=your-gemini-api-key
VITE_GEMINI_MODEL=gemini-1.5-flash
VITE_GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Google Vertex AI (Google Cloud)
VITE_VERTEX_PROJECT_ID=your-gcp-project
VITE_VERTEX_LOCATION=us-central1
VITE_VERTEX_MODEL=gemini-1.5-flash-001
VITE_VERTEX_ACCESS_TOKEN=your-access-token  # Or use gcloud auth

# OpenAI
VITE_OPENAI_API_KEY=your-openai-api-key
VITE_OPENAI_MODEL=gpt-4o-mini

# Quota Governance
VITE_AI_DAILY_TOKEN_LIMIT=1000000
VITE_AI_DAILY_REQUEST_LIMIT=10000
VITE_AI_COST_ALERT_THRESHOLD=100

# ============================================================
# SNAPSHOT SYSTEM
# ============================================================
VITE_SNAPSHOT_ENABLED=true
VITE_SNAPSHOT_STATIC_BASE_URL=/snapshots
VITE_SNAPSHOT_R2_PREFIX=snapshots
VITE_SNAPSHOT_GENERATE_ON_WRITE=true
VITE_SNAPSHOT_GENERATE_INTERVAL_MS=300000
VITE_SNAPSHOT_VERIFY_INTEGRITY=true

# ============================================================
# FEATURE CONTROL
# ============================================================
VITE_FEATURE_CONTROL_ENDPOINT=/api/cache/feature-control.json
VITE_FEATURE_POLL_INTERVAL_MS=60000

# ============================================================
# CUSTOM BACKEND (for custom mode)
# ============================================================
VITE_API_BASE_URL=https://api.sanatanmarga.com

# ============================================================
# ANALYTICS & MONITORING (Optional)
# ============================================================
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_SENTRY_DSN=https://xxx@sentry.io/xxx